  "$surfaces": "[data-surface] keys of the site: fill = its background Theme role; dark = text on it is light (Theme=Dark component variants); tokens = the variables the surface re-points, created as \"<surface>/<name>\" (e.g. inverse/btn-bg).",
  "surfaces": {
    "default": { "fill": "bg-body" },
    "subtle": { "fill": "bg-surface-2" },
    "inverse": {
      "fill": "bg-base",
      "dark": true,
      "tokens": [
        ["text-eyebrow", "all-light-80", "text"],
        ["surface-text-muted", "all-light-80", "text"],
        ["surface-link", "text-contrast", "text+stroke"],
        ["surface-link-hover", "text-contrast", "text+stroke"],
