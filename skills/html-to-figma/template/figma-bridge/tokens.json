{
  "$doc": "Design tokens for build/foundations.js. Replace values with the site's own (from its CSS); keep the semantic NAMES — lib, kit and the core components use them. Every number on the 4px grid.",
  "fonts": { "heading": "Inter", "body": "Inter" },
  "primitives": {
    "neutral/950": "#0B1220", "neutral/900": "#111827", "neutral/700": "#374151", "neutral/600": "#4B5563",
    "neutral/400": "#9CA3AF", "neutral/200": "#E5E7EB", "neutral/100": "#F3F4F6", "neutral/50": "#F9FAFB",
    "brand/900": "#0B2A55", "brand/800": "#0B3A75", "brand/700": "#0B4A95", "brand/100": "#DCE8F8", "brand/50": "#EEF4FC",
    "accent/500": "#14B8A6", "accent/300": "#5EEAD4",
    "success/700": "#15803D", "success/50": "#F0FDF4",
    "warning/700": "#A16207", "warning/50": "#FEFCE8",
    "danger/700": "#B91C1C", "danger/50": "#FEF2F2",
    "white/100": "#FFFFFF"
  },
  "alpha": { "white/76": ["#FFFFFF", 0.76], "white/60": ["#FFFFFF", 0.6], "white/20": ["#FFFFFF", 0.2] },
  "$semanticScopes": "text | fill | stroke | fill+stroke | text+stroke",
  "semantic": [
    ["text/default", "neutral/900", "text"],
    ["text/muted", "neutral/600", "text"],
    ["text/link", "brand/700", "text"],
    ["text/link-hover", "brand/800", "text"],
    ["text/on-action", "white/100", "text"],
    ["text/on-action-dark", "neutral/950", "text"],
    ["text/on-dark", "white/100", "text"],
    ["text/on-dark-muted", "white/76", "text"],
    ["text/on-dark-faint", "white/60", "text"],
    ["text/on-dark-link", "accent/300", "text"],
    ["bg/page", "white/100", "fill"],
    ["bg/surface", "white/100", "fill"],
    ["bg/subtle", "neutral/50", "fill"],
    ["bg/utility", "neutral/100", "fill"],
    ["bg/brand-subtle", "brand/50", "fill"],
    ["bg/inverse", "neutral/950", "fill"],
    ["border/subtle", "neutral/100", "stroke"],
    ["border/default", "neutral/200", "stroke"],
    ["border/control", "neutral/400", "stroke"],
    ["border/strong", "neutral/900", "stroke"],
    ["border/link", "brand/700", "stroke"],
    ["border/on-dark", "white/20", "stroke"],
    ["action/primary", "brand/700", "fill+stroke"],
    ["action/primary-hover", "brand/800", "fill+stroke"],
    ["action/secondary-hover", "brand/50", "fill"],
    ["action/on-dark", "white/100", "fill+stroke"],
    ["action/on-dark-hover", "brand/100", "fill+stroke"],
    ["action/on-dark-border", "white/60", "stroke"],
    ["accent/signature", "accent/500", "fill+stroke"],
    ["focus/default", "brand/700", "stroke"],
    ["focus/on-dark", "accent/500", "stroke"],
    ["image/placeholder", "neutral/100", "fill"],
    ["image/placeholder-border", "neutral/200", "stroke"],
    ["image/placeholder-text", "neutral/600", "text"],
    ["status/success", "success/700", "text+stroke"],
    ["status/success-bg", "success/50", "fill"],
    ["status/warning", "warning/700", "text+stroke"],
    ["status/warning-bg", "warning/50", "fill"],
    ["status/danger", "danger/700", "text+stroke"],
    ["status/danger-bg", "danger/50", "fill"]
  ],
  "space": [4, 8, 12, 16, 20, 24, 32, 40, 48, 56, 64, 72, 80, 96, 128],
  "radius": { "sm": 4, "md": 8, "lg": 16, "full": 999 },
  "grid": { "page": 1512, "columns": 12, "column": 92, "gutter": 24, "margin": 72 },
  "gridMobile": { "page": 440, "columns": 4, "gutter": 16, "margin": 16, "$doc": "Mobile frames (pages[].device \"mobile\", Figma preset iPhone 16 & 17 Pro Max): margin = the site's mobile side padding. Delete if no mobile screens." },
  "$type": "[name, font role heading|body, font style, size, line height (4px grid), letter spacing %, {textCase, decoration, mobile: [size, line height] in the Typography 'Mobile' mode — measure the site at the mobile width}]",
  "type": [
    ["Display/XL", "heading", "Medium", 96, 96, -3, { "mobile": [48, 52] }],
    ["Heading/H1", "heading", "Medium", 64, 68, -3, { "mobile": [36, 40] }],
    ["Heading/H2", "heading", "Medium", 44, 52, -2, { "mobile": [30, 36] }],
    ["Heading/H3", "heading", "Medium", 32, 40, -1.5, { "mobile": [26, 32] }],
    ["Heading/H4", "heading", "Medium", 24, 32, -1],
    ["Heading/H5", "heading", "Medium", 20, 28, -0.5],
    ["Heading/H6", "heading", "Medium", 18, 28, 0],
    ["Body/XL", "body", "Regular", 24, 36, 0],
    ["Body/LG", "body", "Regular", 20, 32, 0],
    ["Body/MD", "body", "Regular", 16, 24, 0],
    ["Body/SM", "body", "Regular", 15, 24, 0],
    ["Body/XS", "body", "Regular", 14, 20, 0],
    ["Body/XS Strong", "body", "Semi Bold", 14, 20, 0],
    ["Body/Caption", "body", "Regular", 13, 20, 0],
    ["Body/Micro", "body", "Regular", 12, 16, 0],
    ["Body/Micro Underline", "body", "Regular", 12, 16, 0, { "decoration": "UNDERLINE" }],
    ["Title/LG", "body", "Semi Bold", 18, 28, 0],
    ["Title/MD", "body", "Semi Bold", 16, 24, 0],
    ["Label/Eyebrow", "body", "Bold", 11, 16, 14, { "textCase": "UPPER" }],
    ["Label/Overline", "body", "Bold", 12, 16, 10, { "textCase": "UPPER" }],
    ["Label/Nav", "body", "Medium", 15, 24, 0],
    ["Label/Link", "body", "Semi Bold", 14, 20, 0],
    ["Label/Button LG", "body", "Semi Bold", 15, 20, 0],
    ["Label/Button SM", "body", "Semi Bold", 13, 16, 0],
    ["Label/Field", "body", "Semi Bold", 13, 16, 0],
    ["Stat/Number", "heading", "Regular", 80, 80, -3],
    ["Brand/Wordmark", "heading", "Bold", 22, 32, 16]
  ],
  "surfaces": { "default": "bg/page", "subtle": "bg/subtle", "brand": "bg/brand-subtle", "inverse": "bg/inverse" },
  "darkSurfaces": ["inverse"],
  "section": { "padY": 128, "ruleBetweenPlain": true },
  "effects": {
    "$doc": "Effect styles from the site's box-shadows (kit elevate(node, name)). Each layer: {x, y, blur, spread, color, alpha}.",
    "Shadow/Card": [{ "y": 24, "blur": 40, "spread": -24, "color": "#111827", "alpha": 0.4 }]
  },
  "gradients": {
    "$doc": "Gradient paint styles from the site's linear-gradients (kit gradient(node, name)). {angle (CSS deg), stops: [[hex, position, alpha?]]}.",
    "Gradient/Brand": { "angle": 135, "stops": [["#0B3A75", 0], ["#0B2A55", 1]] }
  }
}
